<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ data extraction rules.

    Mirrors backup_rules.xml: the settings database and the DataStore
    preferences file travel with the user, and the file domain is included by
    name rather than wholesale so a future icon or widget cache cannot slip into
    a cloud backup. Nothing is written to the external domain at all.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="minimalflow.db" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="minimalflow.db" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
